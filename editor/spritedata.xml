	<sprite string_id="ucology:flower" name="Flower">
        <checkbox nybble="1" title="Randomize"/>
        <checkbox nybble="2" title="Affected by Gravity"/>
        
        <list nybble="3" title="Flower Type" requirednybble="1" requiredval="0">
            <entry value="0">Type A</entry>
            <entry value="1">Type B</entry>
            <entry value="2">Type C</entry>
            <entry value="3">Type D</entry>
            <entry value="4">Type E</entry>
        </list>

        <checkbox nybble="4-5" mask="1" title="Allow Type A" requirednybble="1" requiredval="1"/>
        <checkbox nybble="4-5" mask="2" title="Allow Type B" requirednybble="1" requiredval="1"/>
        <checkbox nybble="4-5" mask="4" title="Allow Type C" requirednybble="1" requiredval="1"/>
        <checkbox nybble="4-5" mask="8" title="Allow Type D" requirednybble="1" requiredval="1"/>
        <checkbox nybble="4-5" mask="16" title="Allow Type E" requirednybble="1" requiredval="1"/>
    </sprite>
	<sprite string_id="ucology:butterfly" name="Butterfly">
        <checkbox nybble="1" title="Randomize"/>
        
        <list nybble="2" title="Butterfly Type" requirednybble="1" requiredval="0">
            <entry value="0">Type A</entry>
            <entry value="1">Type B</entry>
            <entry value="2">Type C</entry>
            <entry value="3">Type D</entry>
            <entry value="4">Type E</entry>
        </list>

        <checkbox nybble="3-4" mask="1" title="Allow Type A" requirednybble="1" requiredval="1"/>
        <checkbox nybble="3-4" mask="2" title="Allow Type B" requirednybble="1" requiredval="1"/>
        <checkbox nybble="3-4" mask="4" title="Allow Type C" requirednybble="1" requiredval="1"/>
        <checkbox nybble="3-4" mask="8" title="Allow Type D" requirednybble="1" requiredval="1"/>
        <checkbox nybble="3-4" mask="16" title="Allow Type E" requirednybble="1" requiredval="1"/>
    </sprite>

    <sprite string_id="ucology:bird" name="Bird">
        <list nybble="1" title="Bird Type">
            <entry value="0">Blue Jay</entry>
            <entry value="1">Rosefinch</entry>
            <entry value="2">Lorikeet</entry>
            <entry value="3">Parrot</entry>
            <entry value="4">Crested Tit</entry>
        </list>

        <checkbox nybble="2" title="Spotted Texture" requirednybble="1" requiredval="4"/>
        
        <list nybble="3" title="Take Player Attention" comment="The player will look at the bird when nearby.">
            <entry value="0">Never</entry>
            <entry value="1">Only while flying</entry>
            <entry value="2">Always</entry>
        </list>
    </sprite>

    <sprite string_id="ucology:player_look_tag" name="Player Look Tag">
        <list nybble="1" title="Target" comment="What the player will look at.">
            <entry value="0">This position</entry>
            <entry value="1">This position when in a location</entry>
            <entry value="2">The screen when in a location</entry>
        </list>

        <value nybble="2-3" title="Location ID" comment="The location ID the player must be in to look at the target." requirednybble="1" requiredval="1-2"/>
        <value nybble="4-5" title="Event ID" comment="If this value is nonzero, the player will look at the target while this event is active. Otherwise, the player will always look at the target if the specified condition is met."/>
        <value nybble="6-7" title="Link ID"/>
    </sprite>

    <sprite string_id="ucology:player_look_tag_link" name="Player Look Tag Link">
        <value nybble="1-2" title="Independent Link ID" comment="Search for an actor with this value as its initial state."/>
        <value nybble="3-4" title="Dependent Link ID" comment="The link ID to pair the link tag with."/>
    </sprite>

    <sprite string_id="ucology:luma" name="Luma">
        <value nybble="1-2" title="Red Color"/>
        <value nybble="3-4" title="Green Color"/>
        <value nybble="5-6" title="Blue Color"/>
        <value nybble="7" title="Brightness" comment="Calculated as 0.5f + (n * 0.1f), where n > 0. The default value for n = 0 is 1.3f."/>
    </sprite>
</sprites>
